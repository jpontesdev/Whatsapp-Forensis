{
  "name": "visualizador-whatsapp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Visualizador local de conversas exportadas do WhatsApp com interface no estilo WhatsApp Web",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"node --no-warnings --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "vite build && node --no-warnings server/index.js",
    "serve": "node --no-warnings server/index.js",
    "exemplos": "vite build && node --no-warnings server/index.js --dir exemplos"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "express": "^5.3.0",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.7"
  }
}
